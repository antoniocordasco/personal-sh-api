PORT=4000
HOST=0.0.0.0

# Auth0 (not secret — these identify your tenant and API)
AUTH0_DOMAIN=your-tenant.uk.auth0.com
AUTH0_AUDIENCE=https://personal-sh-api

# Postgres connection string: postgresql://USER[:PASSWORD]@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://your-mac-username@localhost:5432/personal_sh?schema=public
